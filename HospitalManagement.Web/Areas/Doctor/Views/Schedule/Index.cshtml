@model List<Schedule>
@{ViewData["Title"]="Lịch làm việc hàng tuần";}
<div class="action-row mb-4"><a asp-action="Edit" class="btn btn-primary">+ Thêm ca làm việc</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Ngày</th><th>Giờ khám</th><th>Phút / lượt</th><th>Tối đa</th><th>Phí khám</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@Display.Day(s.DayOfWeek)</td><td>@s.StartTime.ToString("HH:mm") – @s.EndTime.ToString("HH:mm")</td><td>@s.SlotMinutes</td><td>@s.MaxPatientsPerDay</td><td>@Display.Money(s.Fee)</td><td><div class="action-row"><a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-light btn-sm">Sửa</a><form asp-action="Delete" asp-route-id="@s.Id" method="post" data-confirm="Xóa ca làm việc này? Lịch hẹn đã đặt vẫn được giữ."><button class="btn btn-outline-danger btn-sm">Xóa</button></form></div></td></tr>}</tbody></table></div>
