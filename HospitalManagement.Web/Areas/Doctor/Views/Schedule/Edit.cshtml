@model ScheduleVM
@{ViewData["Title"]=Model.Id==0?"Thêm ca làm việc":"Sửa ca làm việc";}
<div class="form-panel" style="max-width:850px"><form asp-action="Edit" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3"><input asp-for="DoctorId" type="hidden"/><div class="col-md-6"><label asp-for="DayOfWeek" class="form-label"></label><select asp-for="DayOfWeek" class="form-select">@foreach(var day in new[]{1,2,3,4,5,6,0}){<option value="@day">@Display.Day(day)</option>}</select></div><div class="col-md-6"><label asp-for="StartTime" class="form-label"></label><input asp-for="StartTime" type="time" class="form-control" /><span asp-validation-for="StartTime"></span></div><div class="col-md-6"><label asp-for="EndTime" class="form-label"></label><input asp-for="EndTime" type="time" class="form-control" /><span asp-validation-for="EndTime"></span></div><div class="col-md-6"><label asp-for="SlotMinutes" class="form-label"></label><input asp-for="SlotMinutes" type="number" class="form-control" /><span asp-validation-for="SlotMinutes"></span></div><div class="col-md-6"><label asp-for="MaxPatientsPerDay" class="form-label"></label><input asp-for="MaxPatientsPerDay" type="number" class="form-control" /><span asp-validation-for="MaxPatientsPerDay"></span></div><div class="col-md-6"><label asp-for="Fee" class="form-label"></label><input asp-for="Fee" type="number" class="form-control" step="0.01" min="0"/><span asp-validation-for="Fee"></span></div></div><p class="small-muted mt-4">Mỗi bác sĩ có một ca mỗi ngày trong tuần. Thay đổi ca chỉ ảnh hưởng đến các lượt đặt mới.</p><div class="action-row"><button class="btn btn-primary">Lưu ca làm việc</button><a asp-action="Index" class="btn btn-light">Quay lại</a></div></form></div>
