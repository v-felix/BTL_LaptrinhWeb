@model List<Appointment>
@{ViewData["Title"]="Lịch khám của tôi";}
<form method="get" class="filter-panel"><div><label for="date" class="form-label">Ngày khám</label><input id="date" name="date" type="date" class="form-control" value="@(ViewBag.Date is DateOnly date?date.ToString("yyyy-MM-dd"):"")"/></div><button class="btn btn-primary">Xem lịch</button><a asp-action="Index" class="btn btn-light">Tất cả</a></form><div class="table-responsive"><table class="table"><thead><tr><th>STT / Mã</th><th>Bệnh nhân</th><th>Ngày giờ</th><th>Trạng thái</th><th>Thao tác</th></tr></thead><tbody>@foreach(var a in Model){<tr><td><strong>Số @a.SerialNo</strong><br/><small>@a.Reference</small></td><td>@a.PatientName<br/><small>@a.PatientAge tuổi · @a.PatientPhone</small></td><td>@a.AppointmentDate.ToString("dd/MM/yyyy")<br/>@a.AppointmentTime.ToString("HH:mm")</td><td><span class="status @a.Status">@Display.Status(a.Status)</span></td><td><div class="action-row"><a asp-area="" asp-controller="Appointment" asp-action="Details" asp-route-id="@a.Id" class="btn btn-light btn-sm">Hồ sơ</a>@if(a.Status==BookingStatus.Pending){<form asp-action="Confirm" method="post"><input name="id" type="hidden" value="@a.Id"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(a.RowVersion)"/><button class="btn btn-primary btn-sm">Xác nhận</button></form>}@if(a.Status==BookingStatus.Confirmed){<a asp-action="Prescribe" asp-route-id="@a.Id" class="btn btn-primary btn-sm">Khám & kê đơn</a>}</div>@if(a.Status is BookingStatus.Pending or BookingStatus.Confirmed){<form asp-action="Cancel" method="post" data-confirm="Hủy lịch khám này?" class="mt-2"><input name="id" type="hidden" value="@a.Id"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(a.RowVersion)"/><label for="cancel-@a.Id" class="visually-hidden">Lý do hủy</label><input id="cancel-@a.Id" name="reason" class="form-control form-control-sm mb-2" placeholder="Lý do hủy" maxlength="1000" required/><button class="btn btn-outline-danger btn-sm">Hủy lịch</button></form>}</td></tr>}</tbody></table></div>@if(!Model.Any()){<p class="empty mt-3">Chưa có bệnh nhân hẹn khám.</p>}
