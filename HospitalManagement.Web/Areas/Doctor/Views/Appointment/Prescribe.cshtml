@model PrescriptionVM
@{ViewData["Title"]="Khám & kê đơn";var a=(Appointment)ViewBag.Appointment;}
<div class="form-panel" style="max-width:900px"><p class="eyebrow">@a.Reference · SỐ @a.SerialNo</p><h2 class="h4">@a.PatientName · @a.PatientAge tuổi</h2><p>@a.AppointmentDate.ToString("dd/MM/yyyy") · @a.AppointmentTime.ToString("HH:mm")</p><p class="prose">Lý do khám: @a.Problem</p><hr/><form asp-action="Prescribe" method="post" data-confirm="Lưu đơn thuốc và hoàn tất lượt khám này?"><input asp-for="AppointmentId" type="hidden"/><input asp-for="RowVersion" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-12"><label asp-for="Diagnosis" class="form-label"></label><textarea asp-for="Diagnosis" rows="4" class="form-control"></textarea><span asp-validation-for="Diagnosis"></span></div><div class="col-12"><label asp-for="MedicineDetails" class="form-label"></label><textarea asp-for="MedicineDetails" rows="7" class="form-control"></textarea><span asp-validation-for="MedicineDetails"></span></div><div class="col-12"><label asp-for="Advice" class="form-label"></label><textarea asp-for="Advice" rows="4" class="form-control"></textarea><span asp-validation-for="Advice"></span></div></div><button class="btn btn-primary mt-4">Lưu đơn thuốc & hoàn tất khám</button></form></div>
