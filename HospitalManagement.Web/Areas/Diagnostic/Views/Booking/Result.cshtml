@model ResultVM
@{ViewData["Title"]="Nhập kết quả xét nghiệm";var b=(BookingDiagnostic)ViewBag.Booking;}
<div class="form-panel" style="max-width:900px"><p class="eyebrow">@b.Reference</p><h2 class="h4">@b.PatientName</h2><p>@b.DiagnosticService.Name · @b.BookingDate.ToString("dd/MM/yyyy")</p><form asp-action="Result" method="post" enctype="multipart/form-data"><input asp-for="BookingId" type="hidden"/><input asp-for="RowVersion" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-12"><label asp-for="Content" class="form-label"></label><textarea asp-for="Content" rows="8" class="form-control"></textarea><span asp-validation-for="Content"></span></div><div class="col-12"><label asp-for="Conclusion" class="form-label"></label><textarea asp-for="Conclusion" rows="4" class="form-control"></textarea><span asp-validation-for="Conclusion"></span></div><div class="col-md-6"><label asp-for="File" class="form-label"></label><input asp-for="File" type="file" class="form-control" accept="application/pdf,.pdf"/><span asp-validation-for="File"></span></div></div><button class="btn btn-primary mt-4">Lưu & trả kết quả</button></form></div>
