@model List<Schedule>
@{ViewData["Title"]="Lịch làm việc hàng tuần";}
<div class="action-row mb-4"><a asp-action="Edit" class="btn btn-primary">+ Thêm ca làm việc</a></div><form method="get" class="filter-panel"><div><label for="doctorId" class="form-label">Bác sĩ</label><select id="doctorId" name="doctorId" class="form-select"><option value="">Tất cả bác sĩ</option>@foreach(Doctor d in ViewBag.Doctors){<option value="@d.Id" selected="@(d.Id==(int?)ViewBag.DoctorId)">@d.User.FullName</option>}</select></div><button class="btn btn-primary">Xem lịch</button></form><div class="table-responsive"><table class="table"><thead><tr><th>Bác sĩ</th><th>Ngày</th><th>Giờ khám</th><th>Phút / lượt</th><th>Tối đa</th><th>Phí khám</th><th></th></tr></thead><tbody>@foreach(var s in Model){<tr><td>@s.Doctor.User.FullName</td><td>@Display.Day(s.DayOfWeek)</td><td>@s.StartTime.ToString("HH:mm") – @s.EndTime.ToString("HH:mm")</td><td>@s.SlotMinutes</td><td>@s.MaxPatientsPerDay</td><td>@Display.Money(s.Fee)</td><td><div class="action-row"><a asp-action="Edit" asp-route-id="@s.Id" class="btn btn-light btn-sm">Sửa</a><form asp-action="Delete" asp-route-id="@s.Id" method="post" data-confirm="Xóa ca làm việc này? Lịch hẹn đã đặt vẫn được giữ."><button class="btn btn-outline-danger btn-sm">Xóa</button></form></div></td></tr>}</tbody></table></div><div class="form-panel mt-4"><h2 class="h5">Gửi thông báo nội bộ</h2><form asp-action="Notify" method="post"><div class="row g-3"><div class="col-md-4"><label for="notifyDoctor" class="form-label">Bác sĩ nhận</label><select id="notifyDoctor" name="doctorId" class="form-select">@foreach(Doctor d in ViewBag.Doctors){<option value="@d.Id">@d.User.FullName</option>}</select></div><div class="col-md-8"><label for="message" class="form-label">Nội dung</label><textarea id="message" name="message" maxlength="2000" class="form-control" required></textarea></div></div><button class="btn btn-outline-primary mt-3">Gửi thông báo</button></form></div>
