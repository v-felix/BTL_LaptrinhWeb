@model News
@{ViewData["Title"]=Model.Id==0?"Thêm mới · Tin tức bệnh viện":"Chỉnh sửa · Tin tức bệnh viện";}
<div class="form-panel" style="max-width:900px"><form asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Title" class="form-label"></label><input asp-for="Title" type="text" class="form-control" /><span asp-validation-for="Title"></span></div><div class="col-md-6"><label asp-for="Category" class="form-label"></label><input asp-for="Category" type="text" class="form-control" /><span asp-validation-for="Category"></span></div><div class="col-md-6"><label asp-for="PublishedDate" class="form-label"></label><input asp-for="PublishedDate" type="date" class="form-control" /><span asp-validation-for="PublishedDate"></span></div><div class="col-12"><label asp-for="Excerpt" class="form-label"></label><textarea asp-for="Excerpt" rows="4" class="form-control"></textarea><span asp-validation-for="Excerpt"></span></div><div class="col-12"><label asp-for="Content" class="form-label"></label><textarea asp-for="Content" rows="12" class="form-control"></textarea><span asp-validation-for="Content"></span></div><div class="col-12"><label class="form-check-label"><input asp-for="IsPublished" class="form-check-input me-2"/><label asp-for="IsPublished"></label></label></div></div><div class="action-row mt-4"><button class="btn btn-primary">Lưu dữ liệu</button><a asp-action="Index" class="btn btn-light">Quay lại</a></div></form></div>
