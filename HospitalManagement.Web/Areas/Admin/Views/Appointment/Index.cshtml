@model List<Appointment>
@{ViewData["Title"]="Quản lý lịch hẹn khám";}
<form method="get" class="filter-panel"><div><label for="q" class="form-label">Tên / SĐT / Mã lịch</label><input id="q" name="q" value="@ViewBag.Q" class="form-control"/></div><div><label for="date" class="form-label">Ngày khám</label><input id="date" name="date" type="date" value="@(ViewBag.Date is DateOnly date?date.ToString("yyyy-MM-dd"):"")" class="form-control"/></div><div><label for="status" class="form-label">Trạng thái</label><select id="status" name="status" class="form-select"><option value="">Tất cả</option>@foreach(var s in Enum.GetValues<BookingStatus>()){<option value="@s" selected="@(s==(BookingStatus?)ViewBag.Status)">@Display.Status(s)</option>}</select></div><div><label for="doctorId" class="form-label">Bác sĩ</label><select id="doctorId" name="doctorId" class="form-select"><option value="">Tất cả</option>@foreach(Doctor d in ViewBag.Doctors){<option value="@d.Id" selected="@(d.Id==(int?)ViewBag.DoctorId)">@d.User.FullName</option>}</select></div><button class="btn btn-primary">Lọc</button><a asp-action="Index" class="btn btn-light">Xóa lọc</a></form>
<div class="table-responsive"><table class="table"><thead><tr><th>Bệnh nhân / Mã lịch</th><th>Bác sĩ</th><th>Ngày giờ</th><th>Trạng thái</th><th>Điều phối</th></tr></thead><tbody>@foreach(var a in Model){<tr><td><a asp-area="" asp-controller="Appointment" asp-action="Details" asp-route-id="@a.Id"><strong>@a.PatientName</strong></a><br/><small>@a.Reference · Số @a.SerialNo</small><br/><span class="small-muted">@a.PatientPhone</span></td><td>@a.Doctor.User.FullName</td><td>@a.AppointmentDate.ToString("dd/MM/yyyy")<br/>@a.AppointmentTime.ToString("HH:mm")</td><td><span class="status @a.Status">@Display.Status(a.Status)</span></td><td>@if(a.Status==BookingStatus.Pending){<form asp-action="Status" method="post" class="mb-2"><input name="id" type="hidden" value="@a.Id"/><input name="status" type="hidden" value="Confirmed"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(a.RowVersion)"/><button class="btn btn-primary btn-sm">Xác nhận</button></form>}@if(a.Status is BookingStatus.Pending or BookingStatus.Confirmed){<form asp-action="Status" method="post" data-confirm="Hủy lịch khám này?"><input name="id" type="hidden" value="@a.Id"/><input name="status" type="hidden" value="Cancelled"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(a.RowVersion)"/><div class="action-row"><input name="reason" maxlength="1000" class="form-control form-control-sm" placeholder="Lý do hủy" aria-label="Lý do hủy" required/><button class="btn btn-outline-danger btn-sm">Hủy lịch</button></div></form>}</td></tr>}</tbody></table></div>@if(!Model.Any()){<p class="empty mt-3">Không có lịch hẹn phù hợp.</p>}
