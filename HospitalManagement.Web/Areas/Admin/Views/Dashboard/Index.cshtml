@model DashboardVM
@{ViewData["Title"]="Tổng quan bệnh viện";}
<div class="row g-3 mb-4"><div class="col-md-6 col-xl-3"><div class="metric"><span>Bác sĩ đang hoạt động</span><strong>@Model.Doctors</strong></div></div><div class="col-md-6 col-xl-3"><div class="metric"><span>Tài khoản bệnh nhân</span><strong>@Model.Patients</strong></div></div><div class="col-md-6 col-xl-3"><div class="metric"><span>Lịch khám hôm nay</span><strong>@Model.Today</strong></div></div><div class="col-md-6 col-xl-3"><div class="metric"><span>Lịch chờ xác nhận</span><strong>@Model.Pending</strong></div></div></div><div class="form-panel mb-4 d-flex justify-content-between align-items-center flex-wrap gap-3"><div><span class="small-muted">Tổng tiền gói khám đã ghi nhận</span><h2 class="h4 mt-2 mb-0">@Display.Money(Model.RecordedPackagePayments)</h2></div><div class="action-row"><a asp-controller="User" asp-action="Create" asp-route-role="Doctor" class="btn btn-primary">Thêm bác sĩ</a><a asp-controller="Appointment" asp-action="Index" class="btn btn-light">Quản lý lịch hẹn →</a></div></div><h2 class="h5 mb-3">Lịch hẹn mới nhất</h2><partial name="_AppointmentTable" model="Model.Appointments"/>
