@model HealthCheck
@{ViewData["Title"]=Model.Id==0?"Thêm mới · Gói khám sức khỏe":"Chỉnh sửa · Gói khám sức khỏe";}
<div class="form-panel" style="max-width:900px"><form asp-action="@(Model.Id==0?"Create":"Edit")" asp-route-id="@(Model.Id==0?(int?)null:Model.Id)" method="post"><input asp-for="Id" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CurrencyCode" class="form-label"></label><select asp-for="CurrencyCode" class="form-select"><option value="VND">VND · Việt Nam đồng</option><option value="BDT">BDT · Bangladesh taka (dữ liệu nguồn)</option></select></div><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" type="text" class="form-control" /><span asp-validation-for="Name"></span></div><div class="col-md-6"><label asp-for="Price" class="form-label"></label><input asp-for="Price" type="number" class="form-control" step="0.01" min="0"/><span asp-validation-for="Price"></span></div><div class="col-12"><label asp-for="Features" class="form-label"></label><textarea asp-for="Features" rows="4" class="form-control"></textarea><span asp-validation-for="Features"></span></div><div class="col-12"><label class="form-check-label"><input asp-for="Popular" class="form-check-input me-2"/><label asp-for="Popular"></label></label></div><div class="col-12"><label class="form-check-label"><input asp-for="IsActive" class="form-check-input me-2"/><label asp-for="IsActive"></label></label></div></div><div class="action-row mt-4"><button class="btn btn-primary">Lưu dữ liệu</button><a asp-action="Index" class="btn btn-light">Quay lại</a></div></form></div>
