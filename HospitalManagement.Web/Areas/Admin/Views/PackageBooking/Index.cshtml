@model List<PackageBooking>
@{ViewData["Title"]="Phiếu gói khám & thu phí";}
<div class="table-responsive"><table class="table"><thead><tr><th>Phiếu / Bệnh nhân</th><th>Gói khám / Ngày</th><th>Phí / Đã thu</th><th>Trạng thái</th><th>Cập nhật</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><a asp-area="" asp-controller="HealthPackage" asp-action="Details" asp-route-id="@b.Id">@b.Reference</a><br/>@b.Patient.FullName</td><td>@b.HealthCheck.Name<br/>@b.BookingDate.ToString("dd/MM/yyyy")</td><td>@Display.Money(b.TotalAmount, b.CurrencyCode)<br/><small>Đã thu @Display.Money(b.AmountPaid, b.CurrencyCode)</small></td><td><span class="status @b.Status">@Display.Status(b.Status)</span>@if(b.CancellationReason!=null){<p class="small-muted mt-2">@b.CancellationReason</p>}</td><td>@if(b.Status is BookingStatus.Pending or BookingStatus.Confirmed){<form asp-action="Update" method="post"><input name="id" type="hidden" value="@b.Id"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(b.RowVersion)"/><div class="row g-2"><div class="col-6"><label class="small-muted" for="paid-@b.Id">Đã thu (@b.CurrencyCode)</label><input id="paid-@b.Id" name="amountPaid" type="number" step="0.01" min="0" max="@b.TotalAmount" value="@b.AmountPaid" class="form-control form-control-sm" required/></div><div class="col-6"><label for="status-@b.Id" class="small-muted">Trạng thái</label><select id="status-@b.Id" name="status" class="form-select form-select-sm">@foreach(var s in Enum.GetValues<BookingStatus>().Where(s=>s==b.Status || AppointmentService.CanTransition(b.Status,s))){<option value="@s" selected="@(s==b.Status)">@Display.Status(s)</option>}</select></div><div class="col-12"><input name="reason" maxlength="1000" class="form-control form-control-sm" placeholder="Lý do nếu hủy" aria-label="Lý do hủy"/></div></div><button class="btn btn-primary btn-sm mt-2">Lưu cập nhật</button></form>}</td></tr>}</tbody></table></div>@if(!Model.Any()){<p class="empty mt-3">Chưa có đăng ký gói khám.</p>}
