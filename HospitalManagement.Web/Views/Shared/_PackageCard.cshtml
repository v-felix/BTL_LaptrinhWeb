@model HealthCheck
<div class="card package-card h-100 @(Model.Popular ? "popular" : "")"><div class="card-body d-flex flex-column">@if(Model.Popular){<p class="speciality">ĐƯỢC QUAN TÂM</p>}<h3 class="card-title">@Model.Name</h3><p class="price my-3">@Display.Money(Model.Price)</p><ul>@foreach(var feature in Model.Features.Split('\n',StringSplitOptions.RemoveEmptyEntries)){<li>@feature</li>}</ul><a asp-area="" asp-controller="HealthPackage" asp-action="Book" asp-route-id="@Model.Id" class="btn btn-primary mt-auto">Đăng ký gói khám ↗</a></div></div>
