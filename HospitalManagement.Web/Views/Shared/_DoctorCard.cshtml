@model Doctor
<div class="card h-100"><div class="card-body d-flex flex-column"><div class="doctor-avatar">@string.Concat(Model.User.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries).TakeLast(2).Select(x => x[0]))</div><p class="speciality">@Model.Speciality</p><h3 class="card-title">@Model.User.FullName</h3><p class="card-text">@Model.Designation</p><div class="mt-auto action-row"><a asp-area="" asp-controller="Home" asp-action="Doctor" asp-route-id="@Model.Id" class="btn btn-light btn-sm">Hồ sơ</a><a asp-area="" asp-controller="Appointment" asp-action="Book" asp-route-doctorId="@Model.Id" class="btn btn-outline-primary btn-sm">Đặt lịch ↗</a></div></div></div>
