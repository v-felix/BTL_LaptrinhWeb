@model List<HealthCheck>
@{ViewData["Title"]="Gói khám sức khỏe";}
<div class="page-banner"><div class="container"><p class="eyebrow">CHĂM SÓC TOÀN DIỆN</p><h1>Gói khám sức khỏe</h1><p>Lựa chọn gói khám theo nhu cầu chăm sóc và tầm soát.</p></div></div><div class="container"><div class="row g-4">@foreach(var package in Model){<div class="col-lg-4"><partial name="_PackageCard" model="package"/></div>}</div>@if(Model.Count==0){<div class="empty">Chưa có gói khám đang cung cấp.</div>}</div>
