@model PackageBooking
@{ViewData["Title"]="Phiếu gói khám " + Model.Reference;}
<div class="form-shell"><div class="form-panel"><p class="eyebrow">PHIẾU GÓI KHÁM</p><div class="section-head"><h1>@Model.Reference</h1><span class="status @Model.Status">@Display.Status(Model.Status)</span></div><dl class="detail-grid"><div><dt>Bệnh nhân</dt><dd>@Model.Patient.FullName</dd></div><div><dt>Gói khám</dt><dd>@Model.HealthCheck.Name</dd></div><div><dt>Ngày hẹn</dt><dd>@Model.BookingDate.ToString("dd/MM/yyyy")</dd></div><div><dt>Tổng phí</dt><dd>@Display.Money(Model.TotalAmount, Model.CurrencyCode)</dd></div><div><dt>Mức đăng ký ban đầu</dt><dd>@Model.DepositPercent% · @Display.Money(Model.TotalAmount*Model.DepositPercent/100, Model.CurrencyCode)</dd></div><div><dt>Đã thu / Còn lại</dt><dd>@Display.Money(Model.AmountPaid, Model.CurrencyCode) / @Display.Money(Model.TotalAmount-Model.AmountPaid, Model.CurrencyCode)</dd></div></dl>@if(Model.CancellationReason!=null){<p class="alert alert-warning">Lý do hủy: @Model.CancellationReason</p>}<a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary">Tải phiếu PDF</a>
@if(Model.PatientId==User.FindFirstValue(ClaimTypes.NameIdentifier) && Model.Status is BookingStatus.Pending or BookingStatus.Confirmed && Model.BookingDate>HospitalClock.Today){<form asp-action="Cancel" method="post" class="mt-4" data-confirm="Hủy đăng ký gói khám này?"><input name="id" type="hidden" value="@Model.Id"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(Model.RowVersion)"/><label for="reason" class="form-label">Lý do hủy</label><input id="reason" name="reason" maxlength="1000" class="form-control mb-3" required/><button class="btn btn-outline-danger">Hủy đăng ký</button></form>}</div></div>
