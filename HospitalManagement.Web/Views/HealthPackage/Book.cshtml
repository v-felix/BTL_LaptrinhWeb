@model BookPackageVM
@{ViewData["Title"]="Đăng ký gói khám";var package=(HealthCheck)ViewBag.Package;}
<div class="form-shell"><div class="form-panel"><p class="eyebrow">ĐĂNG KÝ GÓI KHÁM</p><h1>@package.Name</h1><p class="price">@Display.Money(package.Price, package.CurrencyCode)</p><p class="prose">@package.Features</p><form asp-action="Book" method="post"><input asp-for="PackageId" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="BookingDate" class="form-label"></label><input asp-for="BookingDate" type="date" class="form-control" /><span asp-validation-for="BookingDate"></span></div><div class="col-md-6"><label asp-for="DepositPercent" class="form-label"></label><select asp-for="DepositPercent" class="form-select"><option value="50">Đăng ký đặt cọc 50%</option><option value="100">Đăng ký thanh toán toàn bộ</option></select></div></div><p class="small-muted mt-4">Thanh toán tại bệnh viện. Nhân viên sẽ ghi nhận số tiền thực thu khi tiếp nhận.</p><button class="btn btn-primary">Gửi đăng ký gói khám ↗</button></form></div></div>
