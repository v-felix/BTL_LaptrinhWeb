@model RegisterVM
@{ViewData["Title"]="Tạo tài khoản bệnh nhân";}
<div class="auth-shell"><div class="form-panel"><p class="eyebrow">XET HOSPITAL</p><h1 class="h3 mb-4">Tạo tài khoản bệnh nhân</h1><form asp-action="Register" method="post"><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" type="text" class="form-control" /><span asp-validation-for="FullName"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" type="tel" class="form-control" /><span asp-validation-for="Phone"></span></div><div class="col-md-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control" /><span asp-validation-for="Password"></span></div><div class="col-md-6"><label asp-for="ConfirmPassword" class="form-label"></label><input asp-for="ConfirmPassword" type="password" class="form-control" /><span asp-validation-for="ConfirmPassword"></span></div></div><button class="btn btn-primary w-100 mt-4">Đăng ký</button></form><p class="small-muted mt-3">Mật khẩu tối thiểu 8 ký tự, có chữ thường và chữ số.</p><a asp-action="Login">Đã có tài khoản? Đăng nhập</a></div></div>
