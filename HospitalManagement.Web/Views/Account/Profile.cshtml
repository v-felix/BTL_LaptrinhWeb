@model ProfileVM
@{ViewData["Title"]="Hồ sơ cá nhân";}
<div class="auth-shell"><div class="form-panel"><p class="eyebrow">XET HOSPITAL</p><h1 class="h3 mb-4">Hồ sơ cá nhân</h1><form asp-action="Profile" method="post"><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="FullName" class="form-label"></label><input asp-for="FullName" type="text" class="form-control" /><span asp-validation-for="FullName"></span></div><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" type="tel" class="form-control" /><span asp-validation-for="Phone"></span></div></div><button class="btn btn-primary w-100 mt-4">Lưu / Tiếp tục</button></form><p class="small-muted mt-3">Email đăng nhập: @Model.Email</p><a asp-action="Password">Đổi mật khẩu →</a></div></div>
