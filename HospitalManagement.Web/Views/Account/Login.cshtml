@model LoginVM
@{ViewData["Title"]="Đăng nhập";}
<div class="auth-shell"><div class="form-panel"><p class="eyebrow">XET HOSPITAL</p><h1 class="h3 mb-4">Đăng nhập</h1><form asp-action="Login" method="post"><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" type="email" class="form-control" /><span asp-validation-for="Email"></span></div><div class="col-md-6"><label asp-for="Password" class="form-label"></label><input asp-for="Password" type="password" class="form-control" /><span asp-validation-for="Password"></span></div></div><input asp-for="ReturnUrl" type="hidden"/><label class="mt-3"><input asp-for="RememberMe"/> Ghi nhớ đăng nhập</label><button class="btn btn-primary w-100 mt-4">Đăng nhập</button></form><div class="d-flex justify-content-between mt-4"><a asp-action="Register">Đăng ký tài khoản</a><a asp-action="ForgotPassword">Quên mật khẩu?</a></div></div></div>
