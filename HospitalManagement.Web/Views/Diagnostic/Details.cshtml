@model BookingDiagnostic
@{ViewData["Title"]="Phiếu xét nghiệm " + Model.Reference;}
<div class="form-shell"><div class="form-panel"><p class="eyebrow">PHIẾU XÉT NGHIỆM</p><div class="section-head"><h1>@Model.Reference</h1><span class="status @Model.Status">@Display.Status(Model.Status)</span></div><dl class="detail-grid"><div><dt>Bệnh nhân</dt><dd>@Model.PatientName</dd></div><div><dt>Điện thoại</dt><dd>@Model.PatientPhone</dd></div><div><dt>Dịch vụ</dt><dd>@Model.DiagnosticService.Name</dd></div><div><dt>Ngày giờ hẹn</dt><dd>@Model.BookingDate.ToString("dd/MM/yyyy") · @Model.BookingTime.ToString("HH:mm")</dd></div><div><dt>Phí dịch vụ</dt><dd>@Display.Money(Model.Price, Model.CurrencyCode)</dd></div><div><dt>Thanh toán</dt><dd>@(Model.PaymentStatus==PaymentStatus.Paid?"Đã thu":Model.PaymentStatus==PaymentStatus.Refunded?"Đã hoàn tiền":"Chưa thu")</dd></div></dl><p class="prose">@Model.Notes</p><a asp-action="Download" asp-route-id="@Model.Id" class="btn btn-primary">Tải phiếu / kết quả PDF</a>
@foreach(var r in Model.TestResults.OrderBy(x=>x.DeliveredAt)){<hr/><p class="eyebrow">KẾT QUẢ · @r.DeliveredAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p><div class="prose">@r.Content</div><h2 class="h5 mt-3">Kết luận</h2><p class="prose">@r.Conclusion</p>@if(r.FileName!=null){<a asp-action="ResultFile" asp-route-id="@r.Id" class="btn btn-outline-primary">Tải tệp kết quả đính kèm</a>}}
@if(Model.PatientId==User.FindFirstValue(ClaimTypes.NameIdentifier) && Model.Status is BookingStatus.Pending or BookingStatus.Confirmed && Model.BookingDate.ToDateTime(Model.BookingTime)>HospitalClock.Now){<form asp-action="Cancel" method="post" class="mt-4" data-confirm="Hủy phiếu xét nghiệm này?"><input name="id" type="hidden" value="@Model.Id"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(Model.RowVersion)"/><button class="btn btn-outline-danger">Hủy đăng ký</button></form>}</div></div>
