@model BookDiagnosticVM
@{ViewData["Title"]="Đặt xét nghiệm";var service=(DiagnosticService)ViewBag.Service;}
<div class="form-shell"><div class="form-panel"><p class="eyebrow">ĐĂNG KÝ XÉT NGHIỆM</p><h1>@service.Name</h1><p class="price">@Display.Money(service.Price, service.CurrencyCode)</p><p>@service.Description</p><form asp-action="Book" method="post"><input asp-for="ServiceId" type="hidden"/><div asp-validation-summary="All"></div><div class="row g-3"><div class="col-md-6"><label asp-for="PatientName" class="form-label"></label><input asp-for="PatientName" type="text" class="form-control" /><span asp-validation-for="PatientName"></span></div><div class="col-md-6"><label asp-for="PatientPhone" class="form-label"></label><input asp-for="PatientPhone" type="tel" class="form-control" /><span asp-validation-for="PatientPhone"></span></div><div class="col-md-6"><label asp-for="BookingDate" class="form-label"></label><input asp-for="BookingDate" type="date" class="form-control" /><span asp-validation-for="BookingDate"></span></div><div class="col-md-6"><label asp-for="BookingTime" class="form-label"></label><input asp-for="BookingTime" type="time" class="form-control" min="07:00" max="17:00"/><span asp-validation-for="BookingTime"></span></div><div class="col-md-6"><label asp-for="Address" class="form-label"></label><input asp-for="Address" type="text" class="form-control" /><span asp-validation-for="Address"></span></div><div class="col-md-6"><label asp-for="AppointmentReference" class="form-label"></label><input asp-for="AppointmentReference" type="text" class="form-control" /><span asp-validation-for="AppointmentReference"></span></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" rows="4" class="form-control"></textarea><span asp-validation-for="Notes"></span></div></div><p class="small-muted mt-3">Thanh toán tại bệnh viện sau khi nhân viên tiếp nhận. Phiếu đăng ký chưa phải xác nhận đã thu tiền.</p><button class="btn btn-primary mt-3">Gửi đăng ký xét nghiệm ↗</button></form></div></div>
