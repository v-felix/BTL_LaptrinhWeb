@model List<DiagnosticService>
@{ViewData["Title"]="Dịch vụ xét nghiệm";}
<div class="page-banner"><div class="container"><p class="eyebrow">CHẨN ĐOÁN & XÉT NGHIỆM</p><h1>Dịch vụ xét nghiệm</h1><p>Chọn dịch vụ phù hợp và đặt giờ tiếp nhận.</p></div></div><div class="container"><form method="get" class="filter-panel"><div><label for="q" class="form-label">Tên dịch vụ</label><input id="q" name="q" value="@ViewBag.Q" class="form-control"/></div><div><label for="category" class="form-label">Nhóm dịch vụ</label><select id="category" name="category" class="form-select"><option value="">Tất cả</option>@foreach(string c in ViewBag.Categories){<option value="@c" selected="@(c==(string?)ViewBag.Category)">@c</option>}</select></div><button class="btn btn-primary">Tìm kiếm</button><a asp-action="Index" class="btn btn-light">Xóa lọc</a></form><p class="small-muted">@Model.Count dịch vụ</p><div class="row g-4">@foreach(var s in Model){<div class="col-md-6 col-lg-4"><div class="card h-100"><div class="card-body d-flex flex-column"><p class="speciality">@s.Category</p><h2 class="card-title">@s.Name</h2><p class="card-text">@s.Description</p><p class="small-muted">Mẫu: @s.SampleType · @s.Duration phút · Kết quả sau @s.ReportHours giờ</p><p class="price">@Display.Money(s.Price, s.CurrencyCode)</p><a asp-action="Book" asp-route-id="@s.Id" class="btn btn-outline-primary mt-auto">Đặt xét nghiệm ↗</a></div></div></div>}</div>@if(Model.Count==0){<div class="empty">Chưa có dịch vụ phù hợp.</div>}</div>
