@model BookAppointmentVM
@{ViewData["Title"]="Đặt lịch khám"; var doctors=(List<Doctor>)ViewBag.Doctors;var slots=(List<AvailableSlot>)ViewBag.Slots;}
<div class="form-shell"><div class="form-panel"><p class="eyebrow">LỊCH HẸN CỦA BẠN</p><h1>Đặt lịch khám</h1><p class="text-muted">Chọn bác sĩ và giờ còn trống. Lịch được xác nhận sau khi bệnh viện tiếp nhận.</p><form asp-action="Book" method="post"><div asp-validation-summary="All"></div><h2 class="h5 my-4">01 / Bác sĩ & thời gian</h2><div class="row g-3"><div class="col-md-6"><label asp-for="DoctorId" class="form-label"></label><select asp-for="DoctorId" data-slot-doctor class="form-select"><option value="0">Chọn bác sĩ</option>@foreach(var d in doctors){<option value="@d.Id">@d.User.FullName · @d.Speciality</option>}</select></div><div class="col-md-6"><label asp-for="AppointmentDate" class="form-label"></label><input asp-for="AppointmentDate" type="date" class="form-control" data-slot-date min="@HospitalClock.Today.ToString("yyyy-MM-dd")" max="@HospitalClock.Today.AddDays(90).ToString("yyyy-MM-dd")"/><span asp-validation-for="AppointmentDate"></span></div><div class="col-12"><label asp-for="AppointmentTime" class="form-label"></label><select asp-for="AppointmentTime" data-slot-select class="form-select"><option value="">Chọn giờ khám</option>@foreach(var s in slots){<option value="@s.Time">@s.Time · @Display.Money(s.Fee)</option>}</select><p id="slot-feedback" class="small-muted mt-2" aria-live="polite">Chọn bác sĩ và ngày để xem giờ khám còn trống.</p></div></div><h2 class="h5 my-4">02 / Thông tin bệnh nhân</h2><div class="row g-3"><div class="col-md-6"><label asp-for="PatientName" class="form-label"></label><input asp-for="PatientName" type="text" class="form-control" /><span asp-validation-for="PatientName"></span></div><div class="col-md-6"><label asp-for="PatientPhone" class="form-label"></label><input asp-for="PatientPhone" type="tel" class="form-control" /><span asp-validation-for="PatientPhone"></span></div><div class="col-md-6"><label asp-for="PatientEmail" class="form-label"></label><input asp-for="PatientEmail" type="email" class="form-control" /><span asp-validation-for="PatientEmail"></span></div><div class="col-md-6"><label asp-for="PatientAge" class="form-label"></label><input asp-for="PatientAge" type="number" class="form-control" min="0" max="120"/><span asp-validation-for="PatientAge"></span></div><div class="col-md-6"><label asp-for="PatientGender" class="form-label"></label><select asp-for="PatientGender" class="form-select"><option value="Male">Nam</option><option value="Female">Nữ</option><option value="Other">Khác</option></select></div><div class="col-12"><label asp-for="Problem" class="form-label"></label><textarea asp-for="Problem" rows="4" class="form-control"></textarea><span asp-validation-for="Problem"></span></div></div>@if(User.Identity?.IsAuthenticated != true){<p class="small-muted mt-3">Bạn có thể đặt lịch với tư cách khách. Hãy lưu liên kết xác nhận để xem lại phiếu.</p>}<button class="btn btn-primary w-100 mt-4">Gửi yêu cầu đặt lịch ↗</button></form></div></div>
