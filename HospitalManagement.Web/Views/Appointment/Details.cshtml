@model Appointment
@{ViewData["Title"]="Lịch khám " + Model.Reference;}
<div class="form-shell"><div class="form-panel"><div class="section-head"><div><p class="eyebrow">PHIẾU KHÁM BỆNH</p><h1>@Model.Reference</h1></div><span class="status @Model.Status">@Display.Status(Model.Status)</span></div><dl class="detail-grid"><div><dt>Bệnh nhân</dt><dd>@Model.PatientName</dd></div><div><dt>Điện thoại</dt><dd>@Model.PatientPhone</dd></div><div><dt>Bác sĩ / Chuyên khoa</dt><dd>@Model.Doctor.User.FullName<br/>@Model.Doctor.Speciality</dd></div><div><dt>Ngày giờ khám</dt><dd>@Model.AppointmentDate.ToString("dd/MM/yyyy") · @Model.AppointmentTime.ToString("HH:mm")</dd></div><div><dt>Số thứ tự</dt><dd>@Model.SerialNo</dd></div><div><dt>Phí khám</dt><dd>@Display.Money(Model.Fee)</dd></div><div><dt>Email</dt><dd>@Model.PatientEmail</dd></div><div><dt>Tuổi / Giới tính</dt><dd>@Model.PatientAge / @(Model.PatientGender=="Male"?"Nam":Model.PatientGender=="Female"?"Nữ":"Khác")</dd></div></dl><h2 class="h6">Lý do khám</h2><p class="prose">@Model.Problem</p>@if(Model.CancellationReason!=null){<p class="alert alert-warning">Lý do hủy: @Model.CancellationReason</p>}<div class="action-row no-print"><a asp-action="Download" asp-route-id="@Model.Id" asp-route-token="@ViewBag.Token" class="btn btn-primary">Tải phiếu & đơn thuốc PDF</a><button class="btn btn-light" type="button" onclick="window.print()">In phiếu</button></div>
@foreach(var prescription in Model.Prescriptions.OrderBy(x=>x.CreatedAt)){<hr/><p class="eyebrow">ĐƠN THUỐC · @prescription.CreatedAt.AddHours(7).ToString("dd/MM/yyyy HH:mm")</p><h2 class="h5">Chẩn đoán</h2><p class="prose">@prescription.Diagnosis</p><h2 class="h5">Thuốc và cách dùng</h2><p class="prose">@prescription.MedicineDetails</p><h2 class="h5">Lời dặn</h2><p class="prose">@prescription.Advice</p>}
@if(ViewBag.CanCancel==true){<hr/><form asp-action="Cancel" method="post" data-confirm="Bạn muốn hủy lịch khám này?" class="no-print"><input name="id" type="hidden" value="@Model.Id"/><input name="token" type="hidden" value="@ViewBag.Token"/><input name="rowVersion" type="hidden" value="@Convert.ToBase64String(Model.RowVersion)"/><label for="reason" class="form-label">Lý do hủy lịch</label><input id="reason" name="reason" maxlength="1000" class="form-control mb-3" required/><button class="btn btn-outline-danger">Hủy lịch khám</button></form>}
@if(Model.PatientId==null){<p class="small-muted mt-4 no-print">Hãy lưu liên kết trang này để xem lại phiếu. Liên kết chứa quyền truy cập hồ sơ, chỉ chia sẻ với người được phép.</p>}</div></div>
