@model List<News>
@{ViewData["Title"]="Tin tức bệnh viện";}
<div class="page-banner"><div class="container"><p class="eyebrow">TIN TỨC & HOẠT ĐỘNG</p><h1>Nhịp sống bệnh viện</h1></div></div><div class="container"><form method="get" class="filter-panel"><input name="q" value="@ViewBag.Q" class="form-control" placeholder="Tìm bài viết…" aria-label="Tìm bài viết"/><button class="btn btn-primary">Tìm kiếm</button></form><div class="row g-4">@foreach(var news in Model){<div class="col-md-6 col-lg-4"><partial name="_NewsCard" model="news"/></div>}</div>@if(Model.Count==0){<div class="empty">Chưa có bài viết phù hợp.</div>}</div>
