@model HomeVM
@{ViewData["Title"]="Chăm sóc sức khỏe toàn diện";}
<section class="hero"><div class="container hero-inner"><div><p class="eyebrow">XET SPECIALIZED HOSPITAL</p><h1>Sức khỏe của bạn,<br/><em>sự tận tâm của chúng tôi.</em></h1><p>Kết nối với bác sĩ chuyên khoa, chủ động đặt lịch và theo dõi hành trình chăm sóc sức khỏe của bạn.</p><div class="action-row mt-4"><a asp-controller="Appointment" asp-action="Book" class="btn btn-primary">Đặt lịch khám ↗</a><a asp-action="Doctors" class="btn btn-outline-primary">Tìm bác sĩ</a></div><div class="stats"><div><div class="stat-number">@Model.DoctorCount</div><div class="stat-label">Bác sĩ chuyên khoa</div></div><div><div class="stat-number">@Model.ServiceCount</div><div class="stat-label">Dịch vụ xét nghiệm</div></div><div><div class="stat-number">@Model.Packages.Count</div><div class="stat-label">Gói khám sức khỏe</div></div></div></div><div class="hero-visual"><img src="~/images/cardiacs.png" alt="Dịch vụ chăm sóc sức khỏe tại Xet Hospital"/><div class="hero-note"><strong>Chủ động chăm sóc sức khỏe</strong><small>Đặt lịch · Thăm khám · Theo dõi kết quả</small></div></div></div></section>
<section class="section container"><div class="section-head"><div><p class="eyebrow">ĐỒNG HÀNH CÙNG BẠN</p><h2>Đội ngũ bác sĩ chuyên khoa</h2><p>Lựa chọn chuyên gia phù hợp với nhu cầu thăm khám.</p></div><a asp-action="Doctors">Xem tất cả →</a></div><div class="row g-4">@foreach(var doctor in Model.Doctors){<div class="col-md-6 col-xl-3"><partial name="_DoctorCard" model="doctor"/></div>}</div></section>
<section class="section" style="background:var(--pale)"><div class="container"><div class="section-head"><div><p class="eyebrow">CHĂM SÓC TOÀN DIỆN</p><h2>Gói khám sức khỏe</h2><p>Tầm soát định kỳ, theo dõi sức khỏe lâu dài.</p></div></div><div class="row g-4">@foreach(var package in Model.Packages){<div class="col-lg-4"><partial name="_PackageCard" model="package"/></div>}</div></div></section>
<section class="section container"><div class="feature-strip"><div><h2>Đăng ký xét nghiệm trực tuyến</h2><p>Tra cứu danh mục dịch vụ và nhận kết quả trong hồ sơ cá nhân.</p></div><a asp-controller="Diagnostic" asp-action="Index" class="btn btn-light">Khám phá dịch vụ ↗</a></div></section>
<section class="container pb-4"><div class="section-head"><div><p class="eyebrow">TIN TỨC & HOẠT ĐỘNG</p><h2>Nhịp sống bệnh viện</h2></div><a asp-action="News">Tất cả bài viết →</a></div><div class="row g-4">@foreach(var news in Model.News){<div class="col-md-4"><partial name="_NewsCard" model="news"/></div>}</div></section>
