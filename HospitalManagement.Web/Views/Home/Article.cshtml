@model News
@{ViewData["Title"]=Model.Title;}
<article class="article-shell"><a asp-action="News">← Tin tức bệnh viện</a><p class="eyebrow mt-4">@Model.Category · @Model.PublishedDate.ToString("dd/MM/yyyy")</p><h1>@Model.Title</h1><p class="lead my-4">@Model.Excerpt</p><div class="prose">@Model.Content</div></article>
