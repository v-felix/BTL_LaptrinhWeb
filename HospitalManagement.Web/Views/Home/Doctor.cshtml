@model Doctor
@{ViewData["Title"]=Model.User.FullName;}
<div class="container section"><a asp-action="Doctors">← Đội ngũ bác sĩ</a><div class="row g-4 mt-2"><div class="col-lg-5"><div class="form-panel"><div class="doctor-avatar">BS</div><p class="speciality">@Model.Speciality</p><h1>@Model.User.FullName</h1><p>@Model.Designation</p><p class="prose">@Model.About</p><a asp-controller="Appointment" asp-action="Book" asp-route-doctorId="@Model.Id" class="btn btn-primary">Đặt lịch với bác sĩ ↗</a></div></div><div class="col-lg-7"><h2 class="h4 mb-3">Lịch khám hàng tuần</h2><div class="table-responsive"><table class="table"><thead><tr><th>Ngày</th><th>Giờ khám</th><th>Mỗi lượt</th><th>Phí khám</th></tr></thead><tbody>@foreach(var s in Model.Schedules.OrderBy(x=>x.DayOfWeek)){<tr><td>@Display.Day(s.DayOfWeek)</td><td>@s.StartTime.ToString("HH:mm") – @s.EndTime.ToString("HH:mm")</td><td>@s.SlotMinutes phút</td><td>@Display.Money(s.Fee)</td></tr>}</tbody></table></div>@if(!Model.Schedules.Any()){<p class="empty">Bác sĩ chưa công bố lịch khám.</p>}</div></div></div>
