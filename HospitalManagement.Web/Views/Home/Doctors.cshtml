@model List<Doctor>
@{ViewData["Title"]="Đội ngũ bác sĩ";}
<div class="page-banner"><div class="container"><p class="eyebrow">CHUYÊN GIA CỦA BẠN</p><h1>Đội ngũ bác sĩ</h1><p>Tìm chuyên khoa và lựa chọn lịch khám phù hợp.</p></div></div>
<div class="container"><form method="get" class="filter-panel"><div><label for="q" class="form-label">Tìm tên / chuyên khoa</label><input id="q" name="q" value="@ViewBag.Q" class="form-control"/></div><div><label for="speciality" class="form-label">Chuyên khoa</label><select id="speciality" name="speciality" class="form-select"><option value="">Tất cả</option>@foreach(string s in ViewBag.Specialities){<option value="@s" selected="@(s == (string?)ViewBag.Speciality)">@s</option>}</select></div><button class="btn btn-primary">Tìm bác sĩ</button><a asp-action="Doctors" class="btn btn-light">Xóa lọc</a></form><p class="small-muted">Tìm thấy @Model.Count bác sĩ</p><div class="row g-4">@foreach(var doctor in Model){<div class="col-md-6 col-lg-4 col-xl-3"><partial name="_DoctorCard" model="doctor"/></div>}</div>@if(Model.Count==0){<div class="empty">Chưa tìm thấy bác sĩ phù hợp.</div>}</div>
