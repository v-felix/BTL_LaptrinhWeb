@model PatientDashboardVM
@{ViewData["Title"]="Hồ sơ khám của tôi";}
<div class="container section"><div class="section-head"><div><p class="eyebrow">KHÔNG GIAN CÁ NHÂN</p><h1>Lịch hẹn & hồ sơ sức khỏe</h1><p>Chỉ hiển thị hồ sơ được đặt từ tài khoản của bạn.</p></div><a asp-controller="Account" asp-action="Profile" class="btn btn-outline-primary">Hồ sơ cá nhân</a></div><div class="action-row mb-4"><a asp-controller="Appointment" asp-action="Book" class="btn btn-primary">Đặt lịch mới</a><a asp-controller="Diagnostic" asp-action="Index" class="btn btn-light">Đặt xét nghiệm</a><a asp-controller="HealthPackage" asp-action="Index" class="btn btn-light">Chọn gói khám</a></div><h2 class="h4 mb-3">Lịch khám & đơn thuốc (@Model.Appointments.Count)</h2><partial name="_AppointmentTable" model="Model.Appointments"/>
<h2 class="h4 mt-5 mb-3">Xét nghiệm & kết quả (@Model.Diagnostics.Count)</h2>@if(!Model.Diagnostics.Any()){<div class="empty">Bạn chưa đăng ký xét nghiệm.</div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Mã phiếu</th><th>Dịch vụ</th><th>Ngày giờ</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var d in Model.Diagnostics){<tr><td>@d.Reference</td><td>@d.DiagnosticService.Name</td><td>@d.BookingDate.ToString("dd/MM/yyyy") · @d.BookingTime.ToString("HH:mm")</td><td><span class="status @d.Status">@Display.Status(d.Status)</span></td><td><a asp-controller="Diagnostic" asp-action="Details" asp-route-id="@d.Id">@(d.TestResults.Any()?"Xem kết quả":"Chi tiết") →</a></td></tr>}</tbody></table></div>}
<h2 class="h4 mt-5 mb-3">Gói khám đã đăng ký (@Model.Packages.Count)</h2>@if(!Model.Packages.Any()){<div class="empty">Bạn chưa đăng ký gói khám.</div>}else{<div class="table-responsive"><table class="table"><thead><tr><th>Mã phiếu</th><th>Gói khám</th><th>Ngày</th><th>Đã thu</th><th>Trạng thái</th><th></th></tr></thead><tbody>@foreach(var b in Model.Packages){<tr><td>@b.Reference</td><td>@b.HealthCheck.Name</td><td>@b.BookingDate.ToString("dd/MM/yyyy")</td><td>@Display.Money(b.AmountPaid)</td><td><span class="status @b.Status">@Display.Status(b.Status)</span></td><td><a asp-controller="HealthPackage" asp-action="Details" asp-route-id="@b.Id">Chi tiết →</a></td></tr>}</tbody></table></div>}</div>
